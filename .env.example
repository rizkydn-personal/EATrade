# ============================================================================
# Salin file ini menjadi ".env" lalu isi sesuai kebutuhan.
# setup.bat / setup.sh akan membuat ".env" otomatis dari file ini jika belum ada.
# ============================================================================

# --- Koneksi MT5 (kosongkan semua jika ingin memakai sesi terminal MT5 yang
#     sudah login secara manual di VPS) ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# --- Dashboard ---
SYMBOLS=XAUUSD
REFRESH_RATE_SECONDS=1
HISTORY_DAYS=1
MT5_SERVER_UTC_OFFSET_HOURS=0
EQUITY_CURVE_MAX_POINTS=300
HOST=0.0.0.0
PORT=8000

# --- Admin panel (WAJIB diisi sebelum dipakai di produksi) ---
ADMIN_PASSWORD=ganti_password_ini
ADMIN_SECRET_KEY=
ADMIN_SESSION_HOURS=12

# --- File status/log EA (XAUUSD_scalper_M1.mq5), arahkan ke folder
#     Common\Files milik terminal MT5, contoh:
#     C:\Users\<user>\AppData\Roaming\MetaQuotes\Terminal\Common\Files\ ---
FAILED_ORDERS_LOG_PATH=failed_orders.json
FAILED_ORDERS_MAX_ROWS=200
BOT_STATUS_LOG_PATH=range_breakout_m1_status.json
BOT_EVENTS_LOG_PATH=range_breakout_m1_events.json
BOT_EVENTS_MAX_ROWS=200
BOT_STATUS_STALE_AFTER_SEC=30
BOT_COMMAND_LOG_PATH=bot_command.json
